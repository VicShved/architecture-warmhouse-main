@startuml
title WarmHouse User Service Component Diagram

top to bottom direction

!include ./C4_Component.puml

Container_Boundary(WarmHouseSystem, "Система Теплый дом") {
  Container(AuthService, "Auth Service", "Python, FastAPI", "Аутентификация, выпуск и проверка JWT")
  Container(UserService, "User Service", "Python, FastAPI", "Управление пользователями и домами")
  ContainerDb(UserDatabase, "UserDatabase", "PostgreSQL", "Хранение данных пользователей")
}

Container_Boundary(UserService, "User Service") {
  Component(HouseAPI, "House API", "Управление домами пользователя")
  Component(ServiceLayer, "Service Layer", "Управление пользователями и домами")
  Component(RepositoryLayer, "Repository Layer", "Логика работы с базой данных")
}


BiRel(HouseAPI,ServiceLayer,"Вызовы бизнес логики")
BiRel(ServiceLayer,RepositoryLayer,"Чтение/запись данных")
BiRel(RepositoryLayer,UserDatabase,"Чтение/запись данных")
BiRel(UserService,AuthService,"Валидация JWT")

SHOW_LEGEND()
@enduml