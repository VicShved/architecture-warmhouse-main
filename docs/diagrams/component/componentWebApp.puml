@startuml
title WarmHouse Web App Component Diagram

top to bottom direction

!include ../templates/C4_Component.puml

Person(user, "Пользователь", "Пользователь warmhouse system")
Person(support, "Пользователи службы поддержки", "Операторы и специалисты техподдержки WarmHouse")

Container_Boundary(WarmHouseSystem, "Система Теплый дом") {
  Container(WebApp, "Web приложение", "TypeScript, Vue", "Предоставляет UI пользователям")
  Container(AuthService, "Auth Service", "Python, FastAPI", "Аутентификация, выпуск и проверка JWT")
  Container(UserService, "User Service", "Python, FastAPI", "Управление пользователями и домами")
  Container(SensorService, "Сервис умных устройств", "Python, FastAPI", "Логика управления умными устройствами")
}

Container_Boundary(WebApp, "Web приложение") {
  Component(Router, "Router", "Vue Router", "Маршрутизация страниц")
  Component(Pages, "Pages", "Vue", "Экраны UI: логин, профиль, дома, устройства")
  Component(AuthStore, "Auth Store", "Pinia", "Хранение JWT, состояние авторизации")
  Component(ApiClient, "API Client", "Axios", "HTTP-запросы, подстановка JWT")
}

Rel(user, WebApp, "Пользуется системой")
BiRel(support, WebApp, "Обращения, поддержка пользователей")
Rel(Pages, Router, "Навигация по экранам")
BiRel(Router, AuthStore, "Проверка и хранение JWT")
BiRel(Pages, ApiClient, "Вызовы API")
BiRel(AuthStore, ApiClient, "Передача JWT в запросы")
BiRel(ApiClient, AuthService, "Логин, получение JWT")
BiRel(ApiClient, UserService, "Управление данными пользователя (JWT)")
BiRel(ApiClient, SensorService, "Управление данными умных устройств (проверка JWT)")

SHOW_LEGEND()
@enduml