@startuml

title WarmHome Container Diagram

top to bottom direction

!include ../templates/C4_Container.puml

Person(user, "Пользователь", "Пользователь warmhouse system")
Person(support, "Пользователи службы поддержки", "Операторы и специалисты техподдержки WarmHouse")
System(WarmHouseSystem, "Система Теплый дом", "Система управление умными устройствами")

Container_Boundary(WarmHouseSystem, "Система Теплый дом") {
    Container(AuthService, "Auth Service", "Python, FastAPI", "Аутентификация, выпуск и проверка JWT")
    Container(UserService, "User Service", "Python, FastAPI", "Управление пользователями и домами")
    Container(SensorService, "Сервис умных устройств", "Python, FastAPI", "Логика управления умными устройствами")
    ContainerDb(UserDatabase, "UserDatabase", "PostgreSQL", "Хранение данных пользователей")
    ContainerDb(SensorDatabase, "SensorDatabase", "ClickHouse", "Хранение данных умных устройств")
    ContainerDb(AuthDatabase, "AuthDatabase", "PostgreSQL", "Хранение данных аутентификации")
    Container(WebApp, "Web приложение", "TypeScript, Vue", "Предоставляет UI пользователям")
 }

Boundary(home, "Дома пользователей") {
    System_Ext(api, "API умных устройств", "Взаимодействие с умными устройствами")
 }

Rel(user, WebApp, "Пользуется системой")
Rel(support, WebApp, "Обращения, поддержка пользователей")
Rel(WebApp, AuthService,"Логин, получение JWT")
Rel(UserService,UserDatabase,"Чтение/запись данных пользователей")
Rel(WebApp, SensorService,"Управление данными умных устройств (проверка JWT через AuthService)")
Rel(SensorService,SensorDatabase,"Чтение/запись данных умных устройств")
Rel(UserService,SensorService,"Управление конфигурациями умных устройств (проверка JWT)")
Rel(SensorService,api,"Управление умными устройствами")
Rel(UserService, AuthService, "Проверка учётных данных и JWT")
Rel(SensorService, AuthService, "Проверка учётных данных и JWT")
Rel(WebApp, UserService, "Управление данными пользователя")
Rel(AuthService, AuthDatabase, "Чтение/запись данных аутентификации")

SHOW_LEGEND()
@enduml